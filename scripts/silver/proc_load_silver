CREATE OR ALTER PROCEDURE silver.load_silver
AS
BEGIN
    SET NOCOUNT ON;

    ----------------------------------------------------
    -- Variable declarations for timing & logging
    ----------------------------------------------------
    DECLARE 
        @proc_start_time     DATETIME2 = SYSDATETIME(),
        @step_start_time     DATETIME2,
        @step_end_time       DATETIME2,
        @step_duration_ms    BIGINT;

    BEGIN TRY
        PRINT '=============================================';
        PRINT 'Starting Silver Layer Load';
        PRINT 'Start Time: ' + CONVERT(VARCHAR, @proc_start_time, 120);
        PRINT '=============================================';

        /* ====================================================
           CUSTOMERS
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [Customers] Truncating table: silver.crm_cst_info';

        TRUNCATE TABLE silver.crm_cst_info;

        PRINT '>> [Customers] Inserting data into: silver.crm_cst_info';

        INSERT INTO silver.crm_cst_info (
            cst_id,
            cst_key,
            cst_firstname,
            cst_lastname,
            cst_marital_status,
            cst_gndr,
            cst_create_date
        )
        SELECT
            cst_id,
            cst_key,
            TRIM(cst_firstname),
            TRIM(cst_lastname),
            CASE 
                WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
                WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
                ELSE 'n/a'
            END,
            CASE 
                WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
                WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
                ELSE 'n/a'
            END,
            cst_create_date
        FROM (
            SELECT *,
                   ROW_NUMBER() OVER (
                       PARTITION BY cst_id 
                       ORDER BY cst_create_date DESC
                   ) AS cs_rank
            FROM bronze.crm_cst_info
        ) t
        WHERE cs_rank = 1
          AND cst_id IS NOT NULL;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [Customers] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        /* ====================================================
           PRODUCTS
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [Products] Truncating table: silver.crm_prd_info';

        TRUNCATE TABLE silver.crm_prd_info;

        PRINT '>> [Products] Inserting data into: silver.crm_prd_info';

        INSERT INTO silver.crm_prd_info (
            prd_id,
            prd_key,
            category_id,
            product_key,
            prd_nm,
            prd_cost,
            prd_line,
            prd_start_dt,
            prd_end_dt
        )
        SELECT 
            prd_id,
            prd_key,
            REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_'),
            SUBSTRING(prd_key, 7, LEN(prd_key)),
            prd_nm,
            ISNULL(prd_cost, 0),
            CASE UPPER(LTRIM(RTRIM(prd_line)))
                WHEN 'M' THEN 'Mountain'
                WHEN 'R' THEN 'Road'
                WHEN 'S' THEN 'Other Sales'
                WHEN 'T' THEN 'Touring'
                ELSE 'n/a'
            END,
            CAST(prd_start_dt AS DATE),
            DATEADD(
                DAY,
                -1,
                LEAD(prd_start_dt) OVER (
                    PARTITION BY prd_key 
                    ORDER BY prd_start_dt
                )
            )
        FROM bronze.crm_prd_info;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [Products] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        /* ====================================================
           SALES
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [Sales] Truncating table: silver.crm_sales_details';

        TRUNCATE TABLE silver.crm_sales_details;

        PRINT '>> [Sales] Inserting data into: silver.crm_sales_details';

        INSERT INTO silver.crm_sales_details (
            sls_ord_num,
            sls_prd_key,
            sls_cust_id, 
            sls_order_dt,
            sls_ship_dt,
            sls_due_dt,
            sls_sales, 
            sls_quantity,
            sls_price
        )
        SELECT
            sls_ord_num,
            sls_prd_key,
            sls_cust_id,
            CASE
                WHEN sls_order_dt = 0 OR LEN(sls_order_dt) <> 8 THEN NULL
                ELSE CAST(CAST(sls_order_dt AS VARCHAR) AS DATE)
            END,
            CASE
                WHEN sls_ship_dt = 0 OR LEN(sls_ship_dt) <> 8 THEN NULL
                ELSE CAST(CAST(sls_ship_dt AS VARCHAR) AS DATE)
            END,
            CASE
                WHEN sls_due_dt = 0 OR LEN(sls_due_dt) <> 8 THEN NULL
                ELSE CAST(CAST(sls_due_dt AS VARCHAR) AS DATE)
            END,
            CASE
                WHEN sls_sales IS NULL 
                  OR sls_sales <= 0 
                  OR sls_sales <> sls_quantity * ABS(sls_price)
                THEN sls_quantity * ABS(sls_price)
                ELSE sls_sales
            END,
            sls_quantity,
            CASE
                WHEN sls_price IS NULL OR sls_price <= 0
                THEN sls_sales / NULLIF(sls_quantity, 0)
                ELSE sls_price
            END
        FROM bronze.crm_sales_details;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [Sales] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        /* ====================================================
           ERP CUSTOMERS
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [ERP Customers] Truncating table: silver.erp_CUST_AZ12';

        TRUNCATE TABLE silver.erp_CUST_AZ12;

        PRINT '>> [ERP Customers] Inserting data';

        INSERT INTO silver.erp_CUST_AZ12 (CID, BDATE, GEN)
        SELECT 
            CASE 
                WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LEN(cid))
                ELSE cid
            END,
            CASE 
                WHEN bdate > GETDATE() THEN NULL
                ELSE bdate
            END,
            CASE 
                WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
                WHEN UPPER(TRIM(gen)) IN ('M', 'MALE') THEN 'Male'
                ELSE 'n/a'
            END
        FROM bronze.erp_CUST_AZ12;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [ERP Customers] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        /* ====================================================
           ERP LOCATION
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [ERP Location] Truncating table: silver.erp_LOC_A101';

        TRUNCATE TABLE silver.erp_LOC_A101;

        PRINT '>> [ERP Location] Inserting data';

        INSERT INTO silver.erp_LOC_A101 (CID, CNTRY)
        SELECT
            REPLACE(cid, '-', ''),
            CASE
                WHEN TRIM(cntry) = 'DE' THEN 'Germany'
                WHEN cntry IS NULL OR TRIM(cntry) = '' THEN 'n/a'
                WHEN TRIM(cntry) IN ('US', 'USA') THEN 'United States'
                ELSE TRIM(cntry)
            END
        FROM bronze.erp_LOC_A101;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [ERP Location] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        /* ====================================================
           ERP PRODUCT CATEGORY
        ==================================================== */
        SET @step_start_time = SYSDATETIME();
        PRINT '>> [ERP Product Category] Truncating table: silver.erp_PX_CAT_G1V2';

        TRUNCATE TABLE silver.erp_PX_CAT_G1V2;

        PRINT '>> [ERP Product Category] Inserting data';

        INSERT INTO silver.erp_PX_CAT_G1V2 (ID, CAT, SUBCAT, MAINTENANCE)
        SELECT id, cat, subcat, maintenance
        FROM bronze.erp_PX_CAT_G1V2;

        SET @step_end_time = SYSDATETIME();
        SET @step_duration_ms = DATEDIFF(MILLISECOND, @step_start_time, @step_end_time);
        PRINT '>> [ERP Product Category] Completed in ' + CAST(@step_duration_ms AS VARCHAR) + ' ms';

        ----------------------------------------------------
        -- Total duration
        ----------------------------------------------------
        PRINT '=============================================';
        PRINT 'Silver Load Completed Successfully';
        PRINT 'Total Duration (ms): ' + CAST(DATEDIFF(MILLISECOND, @proc_start_time, SYSDATETIME()) AS VARCHAR);
        PRINT '=============================================';

    END TRY
    BEGIN CATCH
        PRINT '=============================================';
        PRINT 'ERROR OCCURRED DURING SILVER LOAD';
        PRINT 'Error Number : ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Message: ' + ERROR_MESSAGE();
        PRINT 'Error Line   : ' + CAST(ERROR_LINE() AS VARCHAR);
        PRINT 'Procedure    : ' + ISNULL(ERROR_PROCEDURE(), 'N/A');
        PRINT '=============================================';

        THROW;
    END CATCH
END;
GO


EXEC silver.load_silver
